# /etc/komodo/periphery.config.toml — MODÈLE (ne jamais committer la vraie valeur)
# Clés valables pour Komodo 1.x ; vérifier la doc de la version de Komodo Core
# en service (komo.do/docs) — l'authentification Core ↔ Periphery a évolué.

port = 8120
ssl_enabled = true

# Secret partagé avec Komodo Core (Settings → Server → passkey).
passkeys = ["CHANGE_ME"]

# Restreindre aux IP de Komodo Core (exemple : plage de documentation RFC 5737).
allowed_ips = ["192.0.2.10"]

# Où Periphery clone les dépôts / stacks (défauts).
# repo_dir  = "/etc/komodo/repos"
# stack_dir = "/etc/komodo/stacks"

# Statistiques système pour Komodo (CPU/RAM/disque).
stats_polling_rate = "5-sec"
