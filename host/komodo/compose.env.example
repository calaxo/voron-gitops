## /srv/komodo/compose.env — MODÈLE (le vrai fichier n'est JAMAIS commité, chmod 600)
## Même passkey que KOMODO_PASSKEY de Komodo Core (auth v1 « passkey »).
PERIPHERY_PASSKEYS=CHANGE_ME
PERIPHERY_ROOT_DIRECTORY=/srv/komodo
PERIPHERY_SSL_ENABLED=true
PERIPHERY_DISABLE_TERMINALS=false
## Seule l'IP de Komodo Core peut joindre l'agent (exemple RFC 5737).
PERIPHERY_ALLOWED_IPS=192.0.2.10
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
PERIPHERY_LOGGING_PRETTY=false
PERIPHERY_PRETTY_STARTUP_CONFIG=false
