// /etc/apt/apt.conf.d/99-pas-de-maj-auto — installé par host/hardening/harden.sh
// Aucune mise à jour automatique : une mise à jour de Docker/containerd ou du noyau
// en pleine impression redémarre les conteneurs (klippy) ou la machine → impression perdue.
// Mises à jour À LA MAIN, imprimante au repos : voir host/README.md (« Mises à jour »).
APT::Periodic::Enable "0";
APT::Periodic::Update-Package-Lists "0";
APT::Periodic::Download-Upgradeable-Packages "0";
APT::Periodic::AutocleanInterval "0";
APT::Periodic::Unattended-Upgrade "0";
