# Modèle de .env pour stacks/klipper (Komodo l'écrit à partir du champ "environment"
# du stack ; pour un test manuel : cp .env.example stacks/klipper/.env).
# Aucun secret ici : le stack n'en a pas besoin.

TZ=Etc/UTC
# Port HTTP de Mainsail (proxy nginx) et interface d'écoute.
MAINSAIL_PORT=80
MAINSAIL_BIND=0.0.0.0
# Dossier HÔTE contenant mcu.cfg (UUID CAN), monté sur config/klipper/local/.
LOCAL_CONFIG_DIR=/etc/voron-gitops/klipper-local
